<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dbhq.Cpu6502/Dbhq.Cpu6502.csproj" />
    <ProjectReference Include="../../src/Dbhq.Machines.Atari2600/Dbhq.Machines.Atari2600.csproj" />
    <ProjectReference Include="../Dbhq.Cpu6502.TestSupport/Dbhq.Cpu6502.TestSupport.csproj" />
  </ItemGroup>

  <!-- Lets the tests set an observer on the bus (Atari2600Bus.Observable); without it the observer
       is never called. It is on for every test here, as the NES's is for its tests. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Dbhq.Machines.Atari2600.Observable" Value="true" />
  </ItemGroup>
</Project>
