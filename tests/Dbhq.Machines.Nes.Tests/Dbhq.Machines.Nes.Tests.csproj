<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!-- Lets the tests set an observer on the bus (NesBus.Observable); without it the observer is never called.
       It is on for every test in this project, so CI never runs the shape the page runs, with the
       flag off and the observer's calls dropped by the JIT. That shape has nothing else in it: the
       calls are each behind the flag and a null check, and the differential's old hashes, made
       with observation on, matched the first tool's, made without (the lazy chips journal). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Dbhq.Machines.Nes.Observable" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dbhq.Cpu6502/Dbhq.Cpu6502.csproj" />
    <ProjectReference Include="../../src/Dbhq.Machines.Nes/Dbhq.Machines.Nes.csproj" />
    <ProjectReference Include="../Dbhq.Cpu6502.TestSupport/Dbhq.Cpu6502.TestSupport.csproj" />
  </ItemGroup>
</Project>
