* text=auto eol=lf
roms/** binary
# The provenance and rights of the ROMs are text, and their changes should show in a diff.
roms/README.md -binary diff text

# The BBC Micro's preset discs are other people's files, kept byte for byte as
# published (their hashes are in machines/bbc-micro/discs/manifest.json), so git
# never converts their line endings. The READMEs and the manifest are ours.
machines/bbc-micro/discs/** binary
machines/bbc-micro/discs/*/README.md text eol=lf diff merge
machines/bbc-micro/discs/manifest.json text eol=lf diff merge

# The Atari 2600's bundled cartridges are the same: other people's files, kept byte
# for byte (their hashes are in machines/atari-2600/cartridges/manifest.json). The
# READMEs and the manifests are ours.
machines/atari-2600/cartridges/** binary
machines/atari-2600/cartridges/*/README.md text eol=lf diff merge
machines/atari-2600/cartridges/*/manifest.json text eol=lf diff merge
machines/atari-2600/cartridges/manifest.json text eol=lf diff merge
