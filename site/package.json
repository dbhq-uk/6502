{
  "name": "6502-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22" },
  "scripts": {
    "dev": "astro dev --host \"${SITE_HOST:-127.0.0.1}\" --port 4333",
    "build": "astro build",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test",
    "preview": "astro preview --host \"${SITE_HOST:-127.0.0.1}\" --port 4333",
    "results": "node scripts/make-results.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "html-validate": "^11.16.1",
    "wrangler": "4.145.0"
  }
}
