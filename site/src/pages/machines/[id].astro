---
import Base from '../../layouts/Base.astro';
import Kim1Panel from '../../components/Kim1Panel.astro';
import BbcPanel from '../../components/BbcPanel.astro';
import MachinePhoto from '../../components/MachinePhoto.astro';
import MachineModel from '../../components/MachineModel.astro';
import MachinePhotos from '../../components/MachinePhotos.astro';
import { modelsOf } from '../../models/models.mjs';
import { registry, results } from '../../lib/data.mjs';
import { fmt } from '../../lib/figures.mjs';
import { acceptanceSummary, loadTryIt, parseKeys, runningMachines } from '../../lib/machines.mjs';
import { bbcRoms, kim1Roms } from '../../lib/pins.mjs';
import { NOT_MODELLED, downloadBytes, issueUrl, symbolTable } from '../../lib/bbc-micro.mjs';
import { NOT_ON_A_PC, legend } from '../../../public/bbc-keys.js';

// One page for each machine that runs, and only those. "Running" means it runs
// in the browser, so a running machine with no panel to run it in stops the
// build rather than publishing a page that cannot do what the status says.
export function getStaticPaths() {
  return runningMachines(registry).map((m) => ({ params: { id: m.id }, props: { machine: m } }));
}
const { machine } = Astro.props;
const Panel = { 'kim-1': Kim1Panel, 'bbc-micro': BbcPanel }[machine.id];
if (!Panel) throw new Error(`machine ${machine.id} is running but has no panel in src/pages/machines/[id].astro, so its page could not run it`);
// The photograph is required of every running machine (the registry check
// stops the build without one). The 3D model is shown for a machine that claims
// one in the registry (`models`, read through modelsOf); the registry check has
// already refused a claimed model that is not built, and src/models/models.mjs
// says how to add the next. Its loader is tiny, and the model itself is loaded
// only when the visitor gets near it.
const models = modelsOf(machine);
const hasModels = models.length > 0;
// One model is one section. A machine with a case offers two as tabs, and those
// come with the outside model (plan task 9): until then a page with two would
// show one and drop the other without saying so, so the build stops instead.
if (models.length > 1) throw new Error(`machine ${machine.id} claims ${models.length} models, and the page offers one until the two views land as tabs`);
const scripts = [...({ 'kim-1': ['/kim-1.js'], 'bbc-micro': ['/bbc-micro.js'] }[machine.id] ?? []), ...(hasModels ? ['/model-loader.js'] : [])];
const base = `/machines/${machine.id}/`;
const clockMhz = Number(/([\d.]+) MHz/.exec(machine.cpu ?? '')?.[1]);
if (!(clockMhz > 0)) throw new Error(`machine ${machine.id}: its cpu field names no clock in MHz, and the page runs it at that clock`);
const program = loadTryIt(machine.id);
const bbc = machine.id === 'bbc-micro';
const roms = machine.id === 'kim-1' ? kim1Roms() : bbc ? bbcRoms() : [];
// The BBC Micro's panel is given its ROM files and the size of its download,
// read from the build (src/lib/bbc-micro.mjs). The KIM-1's takes neither.
const panelProps = bbc ? { roms: roms.map((r) => r.file), download: downloadBytes() } : {};
const description = bbc
  ? `${machine.name}, running on the 6502 core in the browser, with its own ROMs. Type BBC BASIC in on its keyboard and run it.`
  : `${machine.name}, running on the 6502 core in the browser, with its own ROM. Type a program in on its keypad and run it.`;
const symbols = bbc ? symbolTable() : [];
const notOnAPc = Object.entries(NOT_ON_A_PC).reduce((groups, [key, why]) => groups.set(why, [...(groups.get(why) ?? []), legend(key)]), new Map());
---

<Base title={machine.name} description={description} scripts={scripts}>
  <section class="machine-head">
    <div class="wrap narrow machine-intro">
      <div>
        <p class="meta"><a href="/machines/">All machines</a></p>
        <h1>{machine.name}</h1>
        <p>{machine.year}, {machine.maker}, {machine.cpu}.</p>
        {machine.notes && <p>{machine.notes}</p>}
        <p>{acceptanceSummary(machine, results, fmt)}</p>
      </div>
      <MachinePhoto machine={machine} photo={machine.photos[0]} main />
    </div>
  </section>

  <section class="machine-run" aria-labelledby="run">
    <div class="wrap narrow">
      <h2 id="run">The machine</h2>
      <Panel base={base} clockMhz={clockMhz} {...panelProps} />
    </div>
  </section>

  {program && !bbc && (
    <section aria-labelledby="try">
      <div class="wrap narrow">
        <h2 id="try">Try it</h2>
        <div class="prose">
        <p>Type these keys in order, by clicking them or with the keyboard. After each line the digits should show what is written beside it: x is any digit, and blank means dark. This is the program the acceptance test types in, from the same file, so the two cannot disagree.</p>
        <ol class="steps">
          {program.steps.map((step) => (
            <li>
              <p class="keys">{parseKeys(step.keys).map((k) => <kbd>{k}</kbd>)}</p>
              <p>{step.says}</p>
              <p class="shows">Shows <code>{step.display.trim() === '' ? 'nothing: dark' : step.display}</code></p>
            </li>
          ))}
        </ol>
        <p>With focus on the machine, the keys 0 to 9 and A to F on a keyboard press the same keys on the keypad.</p>
        </div>
      </div>
    </section>
  )}

  {program && bbc && (
    <section aria-labelledby="try">
      <div class="wrap narrow">
        <h2 id="try">Try it</h2>
        <div class="prose">
        <p>Press Start, then type these lines, pressing Return at the end of each. This is the program the acceptance test types in, from the same file, so the two cannot disagree.</p>
        <pre class="bbc-program"><code>{program.lines.join('\n')}</code></pre>
        <p>The screen should then show:</p>
        <pre class="bbc-program"><code>{program.shows.join('\n')}</code></pre>
        <p>The machine starts with CAPS LOCK on, as the real one does, so letters come out as capitals. Some symbols are not where a PC keyboard has them: the table below says where each one is.</p>
        </div>
      </div>
    </section>
  )}

  {bbc && (
    <section aria-labelledby="keyboard">
      <div class="wrap narrow">
        <h2 id="keyboard">The keyboard</h2>
        <div class="prose">
        <p>Every key the BBC Micro has is in the on-screen keys under the screen, in the machine's own layout, for a phone, a tablet or a mouse. Tap SHIFT or CTRL and it stays down for the next key you tap, then lets go, so SHIFT and then 2 types a double quote; tap it again to let go without typing.</p>
        <p>Each key on your keyboard presses the BBC Micro's key in the same place, so the symbols are where the BBC Micro has them, not where your keyboard prints them. A few PC keys stand in for keys of their own: Backspace and Delete for DELETE, Enter for RETURN, End for COPY, the arrow keys for the cursor keys, and Esc for ESCAPE. The Break button, or the Pause key, is BREAK.</p>
        <table class="bbc-symbols">
          <caption>Where the symbols are</caption>
          <thead><tr><th scope="col">To type</th><th scope="col">On the BBC Micro</th><th scope="col">On your keyboard</th></tr></thead>
          <tbody>
            {symbols.map((s) => (
              <tr><td><kbd>{s.character}</kbd></td><td>{s.bbc}</td><td>{s.pc ?? 'not on a PC keyboard here'}</td></tr>
            ))}
          </tbody>
        </table>
        <p>Your keyboard presses every key but these, which are on the on-screen keys only:</p>
        <ul>
          {[...notOnAPc].map(([why, keys]) => <li>{keys.join(', ')}: {why}.</li>)}
        </ul>
        </div>
      </div>
    </section>
  )}

  {bbc && (
    <section aria-labelledby="left-out">
      <div class="wrap narrow">
        <h2 id="left-out">What is not modelled</h2>
        <div class="prose">
        <p>These parts of the Model B are left out. Each has an issue that says what it would take.</p>
        <ul>
          {NOT_MODELLED.map((m) => <li>{m.part[0].toUpperCase() + m.part.slice(1)}: <a href={issueUrl(m.issue)}>issue {m.issue}</a></li>)}
        </ul>
        </div>
      </div>
    </section>
  )}

  {models.map((m) => <MachineModel module={m.module} photos={machine.photos} drawings={machine.drawings} references={machine.references} />)}

  <MachinePhotos machine={machine} model={hasModels} />

  <section aria-labelledby="rom">
    <div class="wrap narrow">
      <h2 id="rom">{bbc ? 'Whose ROMs these are' : 'Whose ROM this is'}</h2>
      <div class="prose">
      <p>{machine.rights}</p>
      {roms.length > 0 && (
        <ul class="roms">
          {roms.map((r) => <li>{r.chip ?? r.name}: <a href={r.url}>the copy in the repository</a>, SHA-256 <code>{r.sha256}</code></li>)}
        </ul>
      )}
      {bbc
        ? <p>The ROMs are kept in the repository, in <code>roms/</code>, with where they came from. Each is checked against its hash when the site is built, and served from this site beside the emulator.</p>
        : <p>The ROM is kept in the repository, in <code>roms/</code>, with where it came from. It is checked against its hash when the site is built, and served from this site beside the emulator.</p>}
      </div>
    </div>
  </section>
</Base>
