---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('docs', 'the-6502-family');
const { Content } = await render(entry);
---

<Base title="The 6502 family" description="Everything that ran on a 6502 or one of its descendants, and which of them use a CPU the core implements.">
  <section>
    <div class="wrap narrow">
      <h1>The 6502 family</h1>
      <div class="prose"><Content /></div>
    </div>
  </section>
</Base>
