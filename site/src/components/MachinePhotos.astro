---
// Every photograph of the original machine the page uses, main photograph first,
// each credited and, for a machine with a 3D model, with what the model took
// from it: the machine's `photos` list in machines/registry.json, in order. The
// main one is also in the page's head, with its credit beside it; here it is in
// the company of the rest. They are reference, so they sit in a closed <details>
// (Fold.astro) in the page's last section, each credit under its own
// photograph. They load lazily, so they add nothing to the page's first load.
import Fold from './Fold.astro';
import MachinePhoto from './MachinePhoto.astro';
import type { Photo } from './MachinePhoto.astro';

interface Props {
  machine: { id: string; name: string; photos: Photo[] };
  /** Whether the machine has a 3D model, so each photograph says what the model took from it. */
  model: boolean;
}
const { machine, model } = Astro.props;
const n = machine.photos.length;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
---

<Fold id="photos" class="photos" data-photos={machine.id} summary={n === 1 ? 'The photograph of the original, and its credit' : `The ${WORDS[n] ?? n} photographs of the original, and their credits`}>
  <p class="photos-intro">{n === 1 ? 'Credited' : 'Each is credited'} as its source gives it.{model && (n === 1 ? ' Under it is what the 3D model took from it.' : ' Under each is what the 3D model took from it.')}</p>
  <div class="photo-grid">
    {machine.photos.map((photo) => <MachinePhoto machine={machine} photo={photo} used={model} />)}
  </div>
</Fold>
