---
// The NES: its screen, the controls a person at the console has (Reset, the
// power switch, the region, the cartridge slot and the sound), the two
// controllers and the line that says how fast this browser runs it.
// public/nes.js brings it to life when the visitor presses Start, and
// downloads nothing before then. Without JavaScript every control is disabled
// and the status line says why.
//
// The canvas is the picture's size, 256 by 240 (FrameBuffer.Width and Height).
// The stylesheet shows it in NTSC's pixel shape, 8:7, and the script sets the
// region's own once a cartridge is in (pictureShape in public/nes.js; PAL's
// pixels are wider).
//
// The screen is where the keyboard goes: with focus on it, the keys play
// controller 1. The script makes it focusable once the machine runs; Tab is
// never taken and Escape lets go, so focus can always move on.
//
// Under the screen is controller 1 as buttons, for touch, held while a finger
// is on them, several at once.
import { megabytes } from '../lib/bbc-micro.mjs';
import { KEYS, KEY_NAMES } from '../../public/nes-keys.js';

interface Props {
  /** Where the machine's files are served from, /machines/nes/. */
  base: string;
  /** The cartridge Start loads, a file under base, and its title; null to wait for the visitor's. */
  rom: { file: string; title: string } | null;
  /** The bytes the Start button downloads, read from the build, or null when this build has no machine. */
  download: number | null;
}
const { base, rom, download } = Astro.props;

// The keys for each button, from the map the script uses, so the two cannot differ.
const keyFor = (button: string) => Object.entries(KEYS).filter(([, b]) => b === button).map(([code]) => KEY_NAMES[code as keyof typeof KEY_NAMES]).join(' or ');
// "a and b", "a, b and c".
const list = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`);
const pad = [
  { button: 'Up', legend: 'Up', area: 'up' },
  { button: 'Left', legend: 'Left', area: 'left' },
  { button: 'Right', legend: 'Right', area: 'right' },
  { button: 'Down', legend: 'Down', area: 'down' },
  { button: 'Select', legend: 'Select', area: 'select' },
  { button: 'Start', legend: 'Start', area: 'start' },
  { button: 'B', legend: 'B', area: 'b' },
  { button: 'A', legend: 'A', area: 'a' },
];
---

<div class="nes" data-nes data-base={base} data-rom={rom?.file} data-rom-title={rom?.title} data-download={download ?? undefined} data-state="static">
  <div class="nes-screen" data-nes-screen role="application" aria-label="The NES's screen" aria-describedby="nes-keys">
    <canvas data-nes-canvas width="256" height="240"></canvas>
  </div>
  <p class="nes-note">The picture is the machine's own, pixel for pixel, as its PPU draws it, shown in the region's pixel shape: 8:7 on NTSC, wider on PAL. It models the picture, not a television: no scan lines, no glow, no curve and no colour bleed.</p>
  <p class="nes-note" id="nes-keys">With the screen focused, the keyboard is controller 1: {list(['Up', 'Down', 'Left', 'Right'].map(keyFor))} for the d-pad, {keyFor('B')} for B, {keyFor('A')} for A, {keyFor('Select')} for Select and {keyFor('Start')} for Start. Tab moves on and Escape lets go, so the page never keeps the keyboard. A gamepad works too, read in the browser's standard layout: the bottom face button is A, the left one B, the middle pair Select and Start, and the first gamepad is controller 1, the second controller 2.</p>
  <div class="nes-controls">
    <button type="button" class="btn pill" data-nes-start disabled>Start the NES{download !== null && `, a download of up to ${megabytes(download)} MB`}</button>
    <button type="button" class="btn small" data-nes-reset disabled>Reset</button>
    <button type="button" class="btn small" data-nes-power disabled>Power off and on</button>
    <button type="button" class="btn small" data-nes-sound aria-pressed="false" disabled>Turn sound on</button>
  </div>
  <p class="nes-status" role="status" data-nes-status>The NES runs in your browser, and it needs JavaScript to do that. With JavaScript off, the page is shown, but nothing runs.</p>
  <p class="nes-line" data-nes-sound-status aria-live="polite">Sound is off.</p>
  <p class="nes-line" data-nes-power-line aria-live="polite"></p>
  <p class="nes-speed" data-nes-speed></p>
  <div class="nes-pad" role="group" aria-label="Controller 1">
    {pad.map((p) => (
      <button type="button" class={`nes-button nes-${p.area}`} data-nes-button={p.button} disabled>{p.legend}</button>
    ))}
  </div>
  <p class="nes-line" data-nes-pads aria-live="polite"></p>
  <fieldset class="nes-region">
    <legend>The region</legend>
    <div class="nes-controls">
      <label class="nes-choice"><input type="radio" name="nes-region" value="NTSC" data-nes-region checked disabled /> NTSC, the console of North America and Japan</label>
      <label class="nes-choice"><input type="radio" name="nes-region" value="PAL" data-nes-region disabled /> PAL, the console of Europe and Australia</label>
    </div>
    <p class="nes-line" data-nes-region-line aria-live="polite">Each cartridge starts in the region its file names, or NTSC when the file does not say. Changing it restarts the machine.</p>
  </fieldset>
  <fieldset class="nes-cartridge">
    <legend>The cartridge</legend>
    <div class="nes-controls">
      <button type="button" class="btn small" data-nes-choose disabled>Load a .nes file</button>
      <input type="file" accept=".nes" data-nes-file hidden />
    </div>
    <p class="nes-line" data-nes-cartridge aria-live="polite">{rom ? `Start puts ${rom.title} in.` : 'Start, then choose a .nes file.'}</p>
    <p class="nes-note">Drop a .nes file on the page, or press Load a .nes file. The file is read in this tab and is not uploaded anywhere. Reset starts the game again and keeps the cartridge's RAM; Power off and on clears it.</p>
    <p class="nes-note">Saving is not built, so a page reload loses battery RAM: a game's saved progress is gone when the page is reloaded or closed.</p>
  </fieldset>
</div>
