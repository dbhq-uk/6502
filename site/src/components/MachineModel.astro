---
// A machine's 3D models: the modules it claims in the registry, whose entries
// are in src/models/models.mjs. The section is hidden in the markup:
// public/model-loader.js shows it, and loads a model's bundle only when the
// model nears the screen or the visitor presses its Load button. Without
// JavaScript it never shows, and the photograph and the machine's own panel are
// the page.
//
// A machine with no case has one model, its board, and its section is as it
// always was: one model, its id the section's own (data-model on the section).
//
// A machine with a case offers its models as views of the same machine (the
// BBC Micro's models design, "How the page offers the two views", built here for
// the NES on 6 October 2026, for the BBC Micro to take up): one section, headed
// "Models of the machine", with a WAI-ARIA tab list named "Views of the model",
// a tab for each view in the registry's order (Outside, then Inside), and a tab
// panel for each, which is that model's root (data-model on the panel) and holds
// everything a single model's section holds, ModelPanel.astro, with its ids
// suffixed by the view. The first tab is selected and the other panels are
// hidden; the loader switches them. A hidden panel never nears the screen, so a
// view's bundle is fetched only once its tab is chosen. The controls are the
// same for every view, so they are said once, after the panels.
import ModelPanel from './ModelPanel.astro';
import { CONTROLS, modelSrc } from '../models/models.mjs';
import { MODELS } from '../models/models.mjs';

interface Source { author: string; sourceUrl: string; licence: string | null; licenceUrl?: string; used: string; caption?: string; title?: string; sha256?: string }
interface Props {
  /** The models the machine claims in the registry, { view, module }, in its order. */
  models: { view: string; module: string }[];
  /** The machine's photographs, drawings and references, from the registry. */
  photos: Source[];
  drawings?: Source[];
  references?: Source[];
}
const { models, photos, drawings = [], references = [] } = Astro.props;
for (const m of models) if (!MODELS[m.module]) throw new Error(`model ${m.module} has no entry in src/models/models.mjs`);
/** A view's tab label: the view's own name, capitalised. A label: no full stop. */
const tabLabel = (view: string) => view.charAt(0).toUpperCase() + view.slice(1);
const one = models.length === 1 && models[0].view === 'board' ? models[0] : null;
const credits = { photos, drawings, references };
---

{one ? (
<section class="model" aria-labelledby="model" data-model={one.module} data-model-src={modelSrc(one.module)} data-model-texture={MODELS[one.module].texture} data-state="idle" hidden>
  <div class="wrap narrow">
    <h2 id="model">A model of the board</h2>
    <ModelPanel module={one.module} suffix="" {...credits} />
  </div>
</section>
) : (
<section class="model" aria-labelledby="model" data-model-section hidden>
  <div class="wrap narrow">
    <h2 id="model">Models of the machine</h2>
    <div class="model-tabs" role="tablist" aria-label="Views of the model" data-model-tabs>
      {models.map((m, i) => <button type="button" class="model-tab" role="tab" id={`model-tab-${m.view}`} aria-selected={String(i === 0)} aria-controls={`model-panel-${m.view}`} tabindex={i === 0 ? '0' : '-1'}>{tabLabel(m.view)}</button>)}
    </div>
    {models.map((m, i) => (
      <div class="model-panel" role="tabpanel" id={`model-panel-${m.view}`} aria-labelledby={`model-tab-${m.view}`} data-model={m.module} data-model-src={modelSrc(m.module)} data-model-texture={MODELS[m.module].texture} data-state="idle" hidden={i > 0}>
        <ModelPanel module={m.module} suffix={`-${m.view}`} {...credits} />
      </div>
    ))}
    <p class="model-help" id="model-help">{[CONTROLS.pointer, CONTROLS.touch, CONTROLS.keys].join(' ')}</p>
  </div>
</section>
)}
