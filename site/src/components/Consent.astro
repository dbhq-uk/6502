---
import { SITE } from '../lib/site.mjs';

// The analytics consent prompt. Markup only: public/consent.js owns the
// behaviour and public/analytics.js owns the tag, both external because this
// site's CSP has no 'unsafe-inline' in script-src.
//
// Decline and Accept are the same size and sit side by side with Decline first.
// A prompt that makes refusing harder than accepting is not consent, and the
// shared dbhq-consent key means a dark pattern here would follow the reader
// across every *.dbhq.uk site.
//
// Initial focus goes to the heading, not to a button, so a bare Enter on
// opening the prompt answers nothing. This is a frontmatter comment on purpose:
// an HTML comment would be served to every reader.
---

<dialog class="consent" data-consent aria-labelledby="consent-title">
  <h2 id="consent-title" tabindex="-1" autofocus>Count this visit?</h2>
  <p>
    This site uses Google Analytics to count how many people read these pages. No cookie is set unless you accept, and
    every page works exactly the same either way.
  </p>
  <p class="consent-note">
    The choice is remembered across dbhq.uk and its sites, so this is asked once. What is collected and who processes it
    is in the <a href={SITE.privacy}>DBHQ privacy policy</a>.
  </p>
  <div class="consent-actions">
    <button type="button" class="btn ghost" data-consent-decline>Decline</button>
    <button type="button" class="btn" data-consent-accept>Accept</button>
  </div>
</dialog>
