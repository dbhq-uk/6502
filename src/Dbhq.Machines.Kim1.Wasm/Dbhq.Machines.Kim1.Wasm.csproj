<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The KIM-1 as .NET WebAssembly, for its page on 6502.dbhq.uk. A plain
    WebAssembly app, not Blazor: site/public/kim-1.js drives it. Published by
    site/scripts/build-machines.mjs into site/public/machines/kim-1/, which is
    git-ignored; nothing it publishes is committed.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The JavaScript interop generator writes unsafe code for [JSExport], and refuses to compile without this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Dbhq.Machines.Kim1.Wasm</AssemblyName>
    <RootNamespace>Dbhq.Machines.Kim1.Wasm</RootNamespace>
    <!-- No culture data: nothing here formats or compares text by culture, and the ICU files would be the biggest download. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No symbols in the published site. -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dbhq.Machines.Kim1/Dbhq.Machines.Kim1.csproj" />
  </ItemGroup>
</Project>
