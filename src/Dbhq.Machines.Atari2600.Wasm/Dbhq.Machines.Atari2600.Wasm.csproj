<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The Atari 2600 as .NET WebAssembly, for the browser speed check in bench/atari-2600-speed/
    (the plan's task 8) and, from task 13, for its page on 6502.dbhq.uk. A plain WebAssembly app,
    not Blazor, in the shape of Dbhq.Machines.Nes.Wasm. The cartridge is not in here: the caller
    gives it to Load as bytes (AGENTS.md rules 3 and 4).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The JavaScript interop generator writes unsafe code for [JSExport], and refuses to compile without this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Dbhq.Machines.Atari2600.Wasm</AssemblyName>
    <RootNamespace>Dbhq.Machines.Atari2600.Wasm</RootNamespace>
    <!-- No culture data: nothing here formats or compares text by culture, and the ICU files would be the biggest download. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No symbols in the published site. -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dbhq.Machines.Atari2600/Dbhq.Machines.Atari2600.csproj" />
  </ItemGroup>
</Project>
